# Store the real copy outside this repository and set SECUREVAULT_ENV_FILE.
NODE_ENV=production
PORT=5000
CORS_ORIGINS=https://vault.example.com
DATABASE_PATH=/var/lib/securevault/vault.sqlite
# Generate four distinct keys using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_PREAUTH_SECRET=
DATA_ENCRYPTION_KEY=
# Only configure this when a known proxy controls the forwarding headers.
TRUST_PROXY=false
BCRYPT_ROUNDS=12
PUBLIC_ORIGIN=https://vault.example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=verification@vault.example.com
